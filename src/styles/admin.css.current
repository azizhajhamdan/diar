/* =============================================
   لوحة التحكم - CSS كامل
   ============================================= */

/* =============================================
   الأساسيات
   ============================================= */

.admin-root {
  min-height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: var(--font-body);
}

/* =============================================
   شاشة تسجيل الدخول
   ============================================= */

.admin-login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: linear-gradient(135deg, var(--bg-primary), var(--bg-secondary));
}

.admin-login-card {
  width: 100%;
  max-width: 420px;
  padding: 40px 28px;
  background: var(--bg-secondary);
  border-radius: 24px;
  border: 1px solid var(--border-strong);
  text-align: center;
  box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.5);
}

.admin-lock-icon {
  width: 80px;
  height: 80px;
  margin: 0 auto 24px;
  border-radius: 22px;
  background: linear-gradient(135deg, var(--gold-dark), var(--gold));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1610;
}

.admin-login-title {
  font-family: var(--font-heading);
  font-size: 26px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.admin-login-sub {
  color: var(--text-muted);
  font-size: 14px;
  margin-bottom: 28px;
}

.admin-login-input {
  width: 100%;
  background: var(--bg-tertiary);
  border: 2px solid var(--border-strong);
  border-radius: 14px;
  padding: 16px 20px;
  color: var(--text-primary);
  font-size: 18px;
  outline: none;
  text-align: center;
  letter-spacing: 0.3em;
  font-family: var(--font-sans);
  margin-bottom: 12px;
  transition: all 0.3s;
}

.admin-login-input:focus {
  border-color: var(--gold);
}

.admin-login-error {
  color: #ef4444;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 16px;
  min-height: 20px;
  opacity: 0;
  transition: opacity 0.3s;
}

.admin-login-error.show {
  opacity: 1;
}

/* =============================================
   Top Bar
   ============================================= */

.admin-topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
}

.admin-logo {
  font-family: var(--font-heading);
  font-size: 24px;
  font-weight: 700;
  color: var(--gold);
}

.admin-logo span {
  color: var(--gold-dark);
}

.admin-actions {
  display: flex;
  gap: 8px;
}

.admin-btn {
  padding: 10px 16px;
  border-radius: 10px;
  background: var(--bg-tertiary);
  border: 1px solid var(--border-strong);
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s;
  font-family: var(--font-body);
}

.admin-btn:hover {
  color: var(--gold);
  border-color: var(--gold);
}

.admin-btn-danger:hover {
  color: #ef4444;
  border-color: #ef4444;
}

/* =============================================
   Tabs
   ============================================= */

.admin-tabs {
  display: flex;
  gap: 4px;
  padding: 0 20px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  overflow-x: auto;
  scrollbar-width: none;
}

.admin-tabs::-webkit-scrollbar { display: none; }

.admin-tab {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 20px;
  background: transparent;
  border: 0;
  border-bottom: 2px solid transparent;
  color: var(--text-muted);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.25s;
  font-family: var(--font-body);
}

.admin-tab:hover {
  color: var(--gold);
}

.admin-tab.active {
  color: var(--gold);
  border-bottom-color: var(--gold);
}

.admin-tab.disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.admin-tab-icon {
  width: 16px;
  height: 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* =============================================
   Container
   ============================================= */

.admin-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 32px 20px 80px;
}

.admin-title {
  font-family: var(--font-heading);
  font-size: 30px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.admin-subtitle {
  color: var(--text-muted);
  font-size: 14px;
  margin-bottom: 32px;
}

/* =============================================
   Stats
   ============================================= */

.admin-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-bottom: 40px;
}

@media (min-width: 768px) {
  .admin-stats {
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
}

.admin-stat-card {
  padding: 24px 20px;
  background: var(--bg-secondary);
  border-radius: 18px;
  border: 1px solid var(--border);
  text-align: center;
}

.admin-stat-num {
  font-family: var(--font-heading);
  font-size: 36px;
  font-weight: 800;
  color: var(--gold);
  line-height: 1;
  margin-bottom: 6px;
}

.admin-stat-label {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 600;
}

/* =============================================
   Info Box
   ============================================= */

.admin-info-box {
  padding: 28px 24px;
  background: rgba(240, 198, 116, 0.05);
  border-radius: 20px;
  border: 1px solid rgba(240, 198, 116, 0.2);
  text-align: center;
}

.admin-info-box h3 {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: 10px;
}

.admin-info-box p {
  color: var(--text-secondary);
  font-size: 14px;
}

/* =============================================
   Search Box
   ============================================= */

.admin-search-box {
  margin-bottom: 24px;
}

.admin-search-input {
  width: 100%;
  padding: 14px 20px;
  border-radius: 14px;
  border: 1.5px solid var(--border-strong);
  background: var(--bg-secondary);
  color: var(--text-primary);
  font-size: 15px;
  outline: none;
  font-family: var(--font-body);
  margin-bottom: 14px;
  transition: all 0.3s;
}

.admin-search-input:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 4px rgba(240, 198, 116, 0.1);
}

.admin-filters {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.admin-filter-btn {
  padding: 10px 16px;
  border-radius: 12px;
  background: var(--bg-secondary);
  border: 1.5px solid var(--border-strong);
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s;
  font-family: var(--font-body);
}

.admin-filter-btn:hover {
  color: var(--gold);
  border-color: var(--gold);
}

.admin-filter-btn.active {
  background: var(--gold);
  color: #1a1610;
  border-color: var(--gold);
}

/* =============================================
   Orders Table
   ============================================= */

.admin-table-wrap {
  background: var(--bg-secondary);
  border-radius: 18px;
  border: 1px solid var(--border);
  overflow: hidden;
}

.admin-table-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 900px;
}

.admin-table thead {
  background: var(--bg-tertiary);
}

.admin-table th {
  padding: 14px 16px;
  text-align: right;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  white-space: nowrap;
  border-bottom: 1px solid var(--border);
}

.admin-table td {
  padding: 16px;
  font-size: 14px;
  color: var(--text-secondary);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}

.admin-table tbody tr {
  cursor: pointer;
  transition: background 0.2s;
}

.admin-table tbody tr:hover {
  background: rgba(240, 198, 116, 0.03);
}

.admin-table tbody tr:last-child td {
  border-bottom: 0;
}

.admin-order-id {
  font-family: var(--font-sans);
  font-weight: 700;
  color: var(--gold);
  font-size: 14px;
}

.admin-customer-name {
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.admin-customer-phone {
  font-size: 12px;
  color: var(--text-muted);
  font-family: var(--font-sans);
}

.admin-type-badge {
  display: inline-block;
  padding: 5px 12px;
  background: rgba(240, 198, 116, 0.1);
  color: var(--gold);
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
}

.admin-date {
  font-size: 13px;
  color: var(--text-secondary);
}

.admin-date.empty {
  color: var(--text-muted);
  font-style: italic;
}

.admin-status {
  display: inline-block;
  padding: 5px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.admin-status.new {
  background: rgba(59, 130, 246, 0.15);
  color: #60a5fa;
}

.admin-status.progress {
  background: rgba(240, 198, 116, 0.15);
  color: var(--gold);
}

.admin-status.ready {
  background: rgba(34, 197, 94, 0.15);
  color: #4ade80;
}

.admin-actions-cell {
  display: flex;
  gap: 4px;
  justify-content: flex-end;
}

.admin-icon-btn {
  width: 36px;
  height: 36px;
  padding: 0;
  border-radius: 10px;
  background: var(--bg-tertiary);
  border: 1px solid var(--border);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.25s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.admin-icon-btn:hover {
  background: var(--bg-primary);
  transform: translateY(-2px);
  border-color: var(--gold);
}

.admin-icon-btn svg {
  width: 18px;
  height: 18px;
}

.admin-icon-btn.print:hover {
  background: rgba(240, 198, 116, 0.2);
  border-color: var(--gold);
}

.admin-icon-btn.danger:hover {
  background: rgba(239, 68, 68, 0.15);
  border-color: #ef4444;
}

.admin-empty {
  padding: 60px 20px;
  text-align: center;
  color: var(--text-muted);
}

.admin-empty h3 {
  font-family: var(--font-heading);
  font-size: 20px;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.admin-empty p {
  font-size: 14px;
}

/* =============================================
   أسعار الجدول
   ============================================= */

.admin-price-total {
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: 2px;
  direction: ltr;
}

.admin-price-remaining {
  font-size: 11px;
  color: #f59e0b;
  font-weight: 600;
}

.admin-price-paid {
  font-size: 11px;
  color: #22c55e;
  font-weight: 600;
}

/* =============================================
   Modal
   ============================================= */

.admin-modal {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  overflow-y: auto;
  animation: fadeIn 0.25s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.admin-modal-card {
  background: var(--bg-secondary);
  border-radius: 22px;
  max-width: 600px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  border: 1px solid var(--border-strong);
  animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

.admin-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  border-bottom: 1px solid var(--border);
}

.admin-modal-header h3 {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
}

.admin-modal-close {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: transparent;
  border: 0;
  color: var(--text-muted);
  font-size: 24px;
  cursor: pointer;
  transition: all 0.25s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-modal-close:hover {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  transform: rotate(90deg);
}

.admin-modal-body {
  padding: 24px;
}

.admin-modal-section {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
  margin: 20px 0 12px;
}

.admin-order-info {
  background: var(--bg-tertiary);
  border-radius: 14px;
  padding: 16px 20px;
  margin-bottom: 24px;
}

.admin-order-info-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
}

.admin-order-info-row:last-child {
  border-bottom: 0;
}

.admin-order-info-label {
  color: var(--text-muted);
  font-weight: 600;
}

.admin-order-info-value {
  color: var(--text-primary);
  font-weight: 600;
}

.admin-order-info-value.ltr {
  direction: ltr;
  font-family: var(--font-sans);
}

.admin-input {
  width: 100%;
  padding: 12px 16px;
  background: var(--bg-tertiary);
  border: 1.5px solid var(--border-strong);
  border-radius: 11px;
  color: var(--text-primary);
  font-size: 14px;
  outline: none;
  font-family: var(--font-body);
  transition: all 0.25s;
  resize: vertical;
}

.admin-input:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 4px rgba(240, 198, 116, 0.1);
}

/* =============================================
   Stages
   ============================================= */

.admin-stages-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.admin-stage-btn {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-radius: 11px;
  background: var(--bg-tertiary);
  border: 1.5px solid transparent;
  color: var(--text-secondary);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s;
  text-align: right;
  font-family: var(--font-body);
  width: 100%;
}

.admin-stage-btn:hover {
  background: rgba(240, 198, 116, 0.08);
}

.admin-stage-btn.active {
  background: rgba(240, 198, 116, 0.15);
  border-color: var(--gold);
  color: var(--gold);
}

.admin-stage-num {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--bg-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-weight: 800;
  font-size: 12px;
  flex-shrink: 0;
}

.admin-stage-btn.active .admin-stage-num {
  background: var(--gold);
  color: #1a1610;
}

/* =============================================
   Modal Footer
   ============================================= */

.admin-modal-footer {
  display: flex;
  gap: 10px;
  padding: 20px 24px;
  border-top: 1px solid var(--border);
  flex-wrap: wrap;
}

.admin-btn-primary {
  flex: 1;
  min-width: 140px;
  padding: 14px 20px;
  border-radius: 12px;
  background: var(--gold);
  border: 0;
  color: #1a1610;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s;
  font-family: var(--font-body);
}

.admin-btn-primary:hover {
  background: var(--gold-dark);
  transform: translateY(-2px);
}

.admin-btn-secondary {
  flex: 1;
  min-width: 120px;
  padding: 14px 20px;
  border-radius: 12px;
  background: var(--bg-tertiary);
  border: 1.5px solid var(--border-strong);
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s;
  font-family: var(--font-body);
}

.admin-btn-secondary:hover {
  border-color: var(--gold);
  color: var(--gold);
}

/* =============================================
   قسم الدفع في Modal
   ============================================= */

.admin-payment-box {
  padding: 20px;
  background: linear-gradient(135deg, rgba(240, 198, 116, 0.06), rgba(240, 198, 116, 0.02));
  border: 1px solid rgba(240, 198, 116, 0.2);
  border-radius: 16px;
  margin-bottom: 24px;
}

.admin-payment-row {
  margin-bottom: 20px;
}

.admin-payment-row:last-child {
  margin-bottom: 0;
}

.admin-payment-row-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.admin-payment-label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.admin-payment-methods {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.admin-payment-method-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 18px 12px;
  background: var(--bg-tertiary);
  border: 2px solid var(--border);
  border-radius: 14px;
  color: var(--text-secondary);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  position: relative;
  min-height: 80px;
}

.admin-payment-method-btn:hover {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(240, 198, 116, 0.05);
  transform: translateY(-2px);
}

.admin-payment-method-btn.active {
  border-color: var(--gold);
  background: linear-gradient(135deg, rgba(240, 198, 116, 0.15), rgba(240, 198, 116, 0.08));
  color: var(--gold);
  box-shadow: 0 8px 24px -8px rgba(240, 198, 116, 0.3);
}

.admin-payment-method-btn.active::after {
  content: '✓';
  position: absolute;
  top: 8px;
  inset-inline-end: 8px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--gold);
  color: #1a1610;
  font-size: 12px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-payment-method-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: inherit;
}

.admin-payment-method-label {
  font-size: 13px;
  font-weight: 700;
}

.admin-payment-input {
  width: 100%;
  padding: 14px 16px;
  background: var(--bg-tertiary);
  border: 1.5px solid var(--border);
  border-radius: 12px;
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 16px;
  font-weight: 700;
  outline: none;
  transition: all 0.25s;
  direction: ltr;
  text-align: left;
}

.admin-payment-input:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 4px rgba(240, 198, 116, 0.1);
  background: var(--bg-secondary);
}

.admin-payment-remaining {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 22px;
  background: linear-gradient(135deg, rgba(240, 198, 116, 0.1), rgba(240, 198, 116, 0.05));
  border-radius: 14px;
  border: 2px dashed rgba(240, 198, 116, 0.4);
  margin-top: 16px;
}

.admin-payment-remaining-label {
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.admin-payment-remaining-value {
  font-family: var(--font-heading);
  font-size: 26px;
  font-weight: 800;
  color: var(--text-muted);
  transition: color 0.3s ease;
  direction: ltr;
}

.admin-payment-remaining-value.pending {
  color: var(--gold);
  text-shadow: 0 0 20px rgba(240, 198, 116, 0.4);
}

.admin-payment-remaining-value.paid {
  color: #22c55e;
  text-shadow: 0 0 20px rgba(34, 197, 94, 0.4);
}

/* =============================================
   Toast
   ============================================= */

.admin-toast {
  position: fixed;
  bottom: 24px;
  inset-inline-end: 24px;
  padding: 14px 24px;
  border-radius: 14px;
  background: var(--gold);
  color: #1a1610;
  font-weight: 700;
  font-size: 14px;
  z-index: 9999;
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.3s;
  pointer-events: none;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
}

.admin-toast.show {
  opacity: 1;
  transform: translateY(0);
}

/* =============================================
   معاينة الفاتورة
   ============================================= */

.invoice-preview-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.95);
  display: flex;
  flex-direction: column;
  animation: fadeIn 0.3s;
}

.invoice-preview-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
}

.invoice-preview-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 24px;
  background: #1a1610;
  border-bottom: 1px solid #2a2420;
  flex-wrap: wrap;
  gap: 12px;
}

.invoice-preview-title {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.invoice-preview-title strong {
  font-family: 'Reem Kufi', sans-serif;
  color: #f0c674;
  font-size: 16px;
}

.invoice-preview-title span {
  color: #8a8070;
  font-size: 12px;
  font-family: 'Inter', sans-serif;
}

.invoice-preview-actions {
  display: flex;
  gap: 10px;
}

.invoice-btn-secondary,
.invoice-btn-print {
  padding: 10px 20px;
  border-radius: 10px;
  border: 0;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s;
  font-family: 'Cairo', sans-serif;
}

.invoice-btn-secondary {
  background: transparent;
  color: #fcf8ee;
  border: 1.5px solid #3a2e15;
}

.invoice-btn-secondary:hover {
  border-color: #ef4444;
  color: #ef4444;
}

.invoice-btn-print {
  background: #f0c674;
  color: #1a1610;
}

.invoice-btn-print:hover {
  background: #d4a73f;
  transform: translateY(-2px);
}

.invoice-preview-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 30px 20px;
  display: flex;
  justify-content: center;
  background: #2a2420;
}

.invoice-preview-page {
  background: #fff;
  border-radius: 4px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  max-width: 210mm;
  width: 100%;
}

.invoice-preview-content {
  padding: 0;
}

/* =============================================
   الفاتورة المضغوطة - مثالية للطباعة
   ============================================= */

.inv {
  width: 100%;
  max-width: 150mm;
  background: #ffffff;
  color: #2a2010;
  font-family: 'Cairo', 'Tajawal', sans-serif;
  padding: 6mm 6mm;
  box-sizing: border-box;
  border: 1.5px solid #c9a850;
  margin: 0 auto;
}

/* ═══ الرأس ═══ */
.inv-header {
  text-align: center;
  padding-bottom: 2mm;
  margin-bottom: 2mm;
  border-bottom: 1px solid #e8dfc8;
}

.inv-logo {
  font-family: 'Reem Kufi', 'Cairo', sans-serif;
  font-size: 24pt;
  font-weight: 700;
  color: #8a7040;
  line-height: 1;
  margin-bottom: 0.5mm;
}

.inv-logo span {
  color: #d4a73f;
}

.inv-tagline {
  font-size: 7pt;
  color: #a89060;
  letter-spacing: 0.1em;
}

/* ═══ شريط المعلومات ═══ */
.inv-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5mm;
  padding: 1.5mm 0;
  margin-bottom: 2mm;
  border-bottom: 1px solid #e8dfc8;
}

.inv-bar-item {
  display: flex;
  align-items: center;
  gap: 1.5mm;
}

.inv-bar-label {
  font-size: 6.5pt;
  color: #a89060;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.inv-bar-value {
  font-size: 9pt;
  font-weight: 700;
  color: #5a4820;
}

.inv-bar-value[dir="ltr"] {
  font-family: 'Inter', sans-serif;
}

.inv-bar-sep {
  color: #c9a850;
}

/* ═══ عنوان الفاتورة ═══ */
.inv-title {
  text-align: center;
  font-family: 'Reem Kufi', sans-serif;
  font-size: 14pt;
  font-weight: 700;
  color: #2a2010;
  letter-spacing: 0.15em;
  padding: 1mm 0 2mm;
}

/* ═══ الأقسام ═══ */
.inv-section {
  margin-bottom: 2mm;
}

.inv-section-head {
  display: flex;
  align-items: center;
  gap: 1.5mm;
  padding: 1mm 0;
  border-bottom: 1px solid #e8dfc8;
  margin-bottom: 1mm;
}

.inv-section-num {
  font-family: 'Inter', sans-serif;
  font-size: 7pt;
  font-weight: 800;
  color: #c9a850;
}

.inv-section-name {
  font-family: 'Reem Kufi', sans-serif;
  font-size: 9pt;
  font-weight: 700;
  color: #5a4820;
}

/* ═══ الشبكة ═══ */
.inv-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border: 1px solid #e8dfc8;
  border-radius: 0.8mm;
  overflow: hidden;
}

.inv-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5mm 2.5mm;
  background: #faf7f0;
  border-bottom: 1px solid #e8dfc8;
  border-left: 1px solid #e8dfc8;
  gap: 2mm;
  min-height: 6mm;
}

.inv-cell.full {
  grid-column: 1 / -1;
}

.inv-grid .inv-cell:nth-child(odd):not(.full) {
  border-left: 0;
}

.inv-grid .inv-cell.full:last-child {
  border-bottom: 0;
}

.inv-label {
  font-size: 7pt;
  color: #a89060;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.inv-value {
  font-size: 8.5pt;
  color: #2a2010;
  font-weight: 700;
  text-align: left;
  word-break: break-word;
}

.inv-value.ltr {
  direction: ltr;
  font-family: 'Inter', 'Cairo', sans-serif;
}

/* ═══ الجدول المالي ═══ */
.inv-table {
  border: 1px solid #e8dfc8;
  border-radius: 0.8mm;
  overflow: hidden;
}

.inv-table-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5mm 2.5mm;
  border-bottom: 1px solid #e8dfc8;
  background: #faf7f0;
}

.inv-table-row:last-child {
  border-bottom: 0;
}

.inv-table-row.inv-table-total {
  background: #f5ecd5;
  border-top: 1.5px solid #c9a850;
  padding: 2mm 2.5mm;
}

.inv-table-label {
  font-size: 8pt;
  color: #7a6535;
  font-weight: 700;
}

.inv-table-total .inv-table-label {
  color: #5a4820;
  font-size: 9pt;
}

.inv-table-value {
  font-family: 'Inter', 'Cairo', sans-serif;
  font-size: 9pt;
  font-weight: 700;
  color: #2a2010;
  direction: ltr;
}

.inv-table-total .inv-table-value {
  font-size: 11pt;
  font-weight: 800;
  color: #5a4820;
}

/* ═══ الملاحظات ═══ */
.inv-notes {
  padding: 1.5mm 2.5mm;
  background: #faf7f0;
  border: 1px solid #e8dfc8;
  border-right: 2.5px solid #d4a73f;
  border-radius: 0.8mm;
  font-size: 8pt;
  line-height: 1.5;
  color: #3a2e15;
}

/* ═══ QR ═══ */
.inv-qr {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4mm;
  padding: 2.5mm;
  margin: 2mm 0;
  background: #faf7f0;
  border: 1px solid #e8dfc8;
  border-radius: 1mm;
}

.inv-qr-box {
  padding: 1.5mm;
  background: #ffffff;
  border: 1.5px solid #c9a850;
  border-radius: 0.8mm;
}

.inv-qr-img {
  width: 22mm;
  height: 22mm;
  display: block;
}

.inv-qr-text {
  display: flex;
  flex-direction: column;
  gap: 0.5mm;
}

.inv-qr-title {
  font-family: 'Reem Kufi', sans-serif;
  font-size: 10pt;
  font-weight: 700;
  color: #5a4820;
}

.inv-qr-sub {
  font-size: 7.5pt;
  color: #7a6535;
}

/* ═══ الفوتر ═══ */
.inv-footer {
  padding-top: 2mm;
  border-top: 1.5px solid #c9a850;
  text-align: center;
}

.inv-thanks {
  font-family: 'Reem Kufi', sans-serif;
  font-size: 10pt;
  font-weight: 700;
  color: #8a7040;
  margin-bottom: 1mm;
}

.inv-contact {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 2.5mm;
  font-size: 7.5pt;
  color: #7a6535;
  margin-bottom: 1mm;
  direction: ltr;
}

.inv-sep {
  color: #c9a850;
}

.inv-copy {
  font-size: 6.5pt;
  color: #a89060;
  padding-top: 1mm;
  border-top: 1px dashed #e8dfc8;
}

/* ═══ الطباعة ═══ */
#diar-print-area {
  display: none;
}

@media print {
  body * {
    visibility: hidden;
  }
  
  #diar-print-area,
  #diar-print-area * {
    visibility: visible;
  }
  
  #diar-print-area {
    display: block !important;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background: #fff;
  }
  
  .inv {
    box-shadow: none;
    page-break-inside: avoid;
    border: 1.5px solid #c9a850;
  }
  
  @page {
    size: A4 portrait;
    margin: 15mm;
  }
}
/* =============================================
   التفاصيل المالية
   ============================================= */

.invoice-financial-box {
  padding: 4mm;
  background: #faf7f0;
  border: 1px solid #e8dfc8;
  border-radius: 3mm;
  display: flex;
  flex-direction: column;
  gap: 2mm;
}

.invoice-financial-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 3mm 4mm;
  background: #ffffff;
  border-radius: 2mm;
  border: 1px solid #f0e8d4;
}

.invoice-financial-row.highlight {
  background: #faf7f0;
  border: 2px solid #c9a850;
  padding: 4mm;
}

.invoice-financial-row.highlight.complete {
  background: #f0f9f4;
  border-color: #d4a73f;
}

.invoice-financial-label {
  font-family: 'IBM Plex Sans Arabic', 'Cairo', sans-serif;
  font-size: 10pt;
  font-weight: 700;
  color: #8a7040;
  letter-spacing: 0.05em;
}

.invoice-financial-row.highlight .invoice-financial-label {
  font-size: 11pt;
  color: #8a7040;
}

.invoice-financial-value {
  font-family: 'Tajawal', 'Cairo', sans-serif;
  font-size: 12pt;
  font-weight: 800;
  color: #d4a73f;
  direction: ltr;
}

.invoice-financial-value.paid {
  color: #d4a73f;
}

.invoice-financial-value.remaining {
  color: #d4a73f;
  font-size: 14pt;
}

.invoice-financial-value.paid-complete {
  color: #22c55e;
  font-size: 14pt;
  font-weight: 900;
}

/* طريقة الدفع */
.invoice-financial-row.payment-row {
  flex-direction: column;
  align-items: flex-start;
  gap: 3mm;
  padding: 4mm;
}

.invoice-payment-buttons {
  display: flex;
  gap: 2mm;
  width: 100%;
}

.invoice-payment-btn {
  flex: 1;
  padding: 3mm 2mm;
  border-radius: 2mm;
  text-align: center;
  font-family: 'Tajawal', 'Cairo', sans-serif;
  font-size: 10pt;
  font-weight: 700;
  border: 1.5px solid #e8dfc8;
  background: #faf7f0;
  color: #a89060;
  position: relative;
}

.invoice-payment-btn.active {
  background: linear-gradient(135deg, #d4a73f, #c9a850);
  color: #ffffff;
  border-color: #c9a850;
  box-shadow: 0 2mm 4mm rgba(212, 167, 63, 0.3);
}

.invoice-payment-btn.active::after {
  content: '✓';
  position: absolute;
  top: -1.5mm;
  right: -1.5mm;
  width: 5mm;
  height: 5mm;
  border-radius: 50%;
  background: #22c55e;
  color: #ffffff;
  font-size: 8pt;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* QR */
.invoice-qr-center {
  text-align: center;
  margin: 8mm 0;
  padding: 6mm 4mm;
  background: linear-gradient(135deg, #faf7f0, #f5ecd5);
  border: 2px dashed #c9a850;
  border-radius: 4mm;
}

.invoice-qr-frame {
  display: inline-block;
  padding: 3mm;
  background: #fff;
  border: 1px solid #c9a850;
  border-radius: 3mm;
  margin-bottom: 3mm;
}

.invoice-qr-img {
  width: 45mm;
  height: 45mm;
  display: block;
}

.invoice-qr-caption {
  font-family: 'IBM Plex Sans Arabic', 'Cairo', sans-serif;
  font-size: 12pt;
  color: #8a7040;
  font-weight: 600;
  letter-spacing: 0.05em;
}

/* الفوتر */
.invoice-footer-new {
  margin-top: auto;
  padding-top: 6mm;
  padding-bottom: 4mm;
  border-top: 1px solid #c9a850;
  text-align: center;
}

.invoice-thanks-new {
  font-family: 'IBM Plex Sans Arabic', 'Cairo', sans-serif;
  font-size: 16pt;
  font-weight: 700;
  color: #8a7040;
  margin-bottom: 4mm;
  letter-spacing: 0.05em;
}

.invoice-contact-new {
  display: flex;
  justify-content: center;
  gap: 12mm;
  margin-bottom: 4mm;
}

.invoice-contact-line {
  display: flex;
  align-items: center;
  gap: 2mm;
  font-family: 'Tajawal', 'Cairo', sans-serif;
  font-size: 10pt;
  color: #7a6535;
}

.invoice-contact-text.ltr {
  direction: ltr;
}

.invoice-copyright-new {
  font-family: 'Tajawal', 'Cairo', sans-serif;
  font-size: 8pt;
  color: #a89060;
  letter-spacing: 0.05em;
  padding-top: 3mm;
  border-top: 1px dashed #e8dfc8;
}

/* =============================================
   الطباعة
   ============================================= */

#diar-print-area {
  display: none;
}

@media print {
  body * {
    visibility: hidden;
  }
  
  #diar-print-area,
  #diar-print-area * {
    visibility: visible;
  }
  
  #diar-print-area {
    display: block !important;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background: #fff;
  }
  
  .diar-invoice-wrapper {
    box-shadow: none;
    page-break-inside: avoid;
    padding: 0;
  }
  
  @page {
    size: A4;
    margin: 10mm;
  }
}

/* =============================================
   الموبايل
   ============================================= */

@media (max-width: 768px) {
  .admin-table {
    min-width: 700px;
  }
  
  .admin-table th,
  .admin-table td {
    padding: 10px 8px;
    font-size: 12px;
  }
  
  .admin-modal-footer {
    flex-direction: column;
  }
  
  .admin-btn-primary,
  .admin-btn-secondary {
    width: 100%;
  }
  
  .invoice-preview-toolbar {
    padding: 12px 16px;
  }
  
  .invoice-preview-title strong {
    font-size: 14px;
  }
  
  .invoice-logo-big {
    font-size: 38pt;
  }
  
  .invoice-title-new {
    font-size: 20pt;
  }
  
  .invoice-qr-img {
    width: 35mm;
    height: 35mm;
  }
  
  .invoice-contact-new {
    flex-direction: column;
    gap: 2mm;
  }
  
  .invoice-grid-2 {
    grid-template-columns: 1fr;
  }
  
  .admin-payment-row-grid {
    grid-template-columns: 1fr;
  }
  
  .admin-payment-methods {
    grid-template-columns: 1fr;
  }
  
  .admin-payment-method-btn {
    flex-direction: row;
    min-height: 56px;
    padding: 14px 16px;
    gap: 12px;
  }
  
  .admin-payment-method-btn.active::after {
    position: static;
    margin-inline-start: auto;
  }
}

/* =============================================
   CMS — إدارة المحتوى
   ============================================= */

.cms-content {
  padding-bottom: 100px;
}

.cms-header {
  margin-bottom: 32px;
}

.cms-header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  flex-wrap: wrap;
}

.cms-header-top .admin-title {
  margin-bottom: 6px;
}

.cms-save-btn-top {
  padding: 12px 24px;
  font-size: 13px;
  white-space: nowrap;
}

.cms-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  min-height: 600px;
}

@media (min-width: 1024px) {
  .cms-layout {
    grid-template-columns: 220px 1fr;
    gap: 24px;
  }
}

.cms-sidebar {
  display: flex;
  flex-direction: row;
  gap: 6px;
  padding: 8px;
  background: var(--bg-secondary);
  border-radius: 16px;
  border: 1px solid var(--border);
  overflow-x: auto;
  scrollbar-width: none;
}

.cms-sidebar::-webkit-scrollbar {
  display: none;
}

@media (min-width: 1024px) {
  .cms-sidebar {
    flex-direction: column;
    padding: 12px;
    overflow-x: visible;
    align-self: flex-start;
    position: sticky;
    top: 80px;
  }
}

.cms-nav-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 11px;
  background: transparent;
  border: 1.5px solid transparent;
  color: var(--text-secondary);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
  white-space: nowrap;
  text-align: right;
  width: 100%;
}

.cms-nav-btn:hover {
  background: var(--bg-tertiary);
  color: var(--text-primary);
}

.cms-nav-btn.active {
  background: rgba(240, 198, 116, 0.12);
  color: var(--gold);
  border-color: rgba(240, 198, 116, 0.25);
}

.cms-nav-icon {
  width: 16px;
  height: 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cms-nav-label {
  flex: 1;
}

.cms-area {
  background: var(--bg-secondary);
  border-radius: 18px;
  border: 1px solid var(--border);
  padding: 24px 20px;
  min-height: 500px;
}

@media (min-width: 768px) {
  .cms-area {
    padding: 32px 28px;
  }
}

.cms-section-content {
  animation: cmsFadeIn 0.3s ease;
}

@keyframes cmsFadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cms-section-title {
  font-family: var(--font-heading);
  font-size: 22px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6px;
}

.cms-section-desc {
  color: var(--text-muted);
  font-size: 13px;
  margin-bottom: 24px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}

.cms-field {
  margin-bottom: 18px;
}

.cms-field-label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 8px;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

.cms-field-input {
  width: 100%;
  padding: 12px 14px;
  background: var(--bg-tertiary);
  border: 1.5px solid var(--border);
  border-radius: 10px;
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 14px;
  outline: none;
  transition: all 0.25s ease;
  resize: vertical;
}

.cms-field-input:focus {
  border-color: var(--gold);
  background: var(--bg-secondary);
  box-shadow: 0 0 0 4px rgba(240, 198, 116, 0.1);
}

.cms-field-input::placeholder {
  color: var(--text-muted);
}

.cms-item-box {
  padding: 20px;
  background: var(--bg-tertiary);
  border-radius: 14px;
  border: 1px solid var(--border);
  margin-bottom: 16px;
}

.cms-item-title {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}

.cms-image-row {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
}

.cms-image-row .cms-field-input {
  flex: 1;
}

.cms-upload-btn {
  padding: 12px 18px;
  background: var(--gold);
  color: #1a1610;
  border: 0;
  border-radius: 10px;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  white-space: nowrap;
  flex-shrink: 0;
}

.cms-upload-btn:hover {
  background: var(--gold-dark);
  transform: translateY(-2px);
}

.cms-image-preview {
  margin-top: 10px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--bg-tertiary);
  min-height: 0;
  transition: all 0.3s ease;
}

.cms-image-preview:empty {
  display: none;
}

.cms-image-preview img {
  width: 100%;
  max-height: 250px;
  object-fit: cover;
  display: block;
}

.cms-loading {
  padding: 40px;
  text-align: center;
  color: var(--gold);
  font-size: 13px;
  font-weight: 600;
}

.cms-image-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 12px;
}

.cms-image-list-item {
  display: grid;
  grid-template-columns: 60px 1fr 40px 36px;
  gap: 8px;
  align-items: center;
  padding: 8px;
  background: var(--bg-secondary);
  border-radius: 10px;
  border: 1px solid var(--border);
}

.cms-image-thumb {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cms-image-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cms-upload-mini {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background: rgba(240, 198, 116, 0.15);
  border: 1px solid rgba(240, 198, 116, 0.3);
  color: var(--gold);
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.cms-upload-mini:hover {
  background: rgba(240, 198, 116, 0.3);
  border-color: var(--gold);
  transform: translateY(-2px);
}

.cms-loading-mini {
  width: 20px;
  height: 20px;
  border: 2px solid rgba(240, 198, 116, 0.3);
  border-top-color: var(--gold);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.cms-remove-btn {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: rgba(239, 68, 68, 0.1);
  border: 0;
  color: #ef4444;
  font-size: 20px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-body);
  line-height: 1;
}

.cms-remove-btn:hover {
  background: rgba(239, 68, 68, 0.2);
  transform: scale(1.1);
}

.cms-add-btn {
  padding: 10px 16px;
  background: transparent;
  border: 1.5px dashed var(--border-strong);
  border-radius: 10px;
  color: var(--text-secondary);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
  width: 100%;
}

.cms-add-btn:hover {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(240, 198, 116, 0.05);
}

.cms-save-bar {
  position: static;
  margin-top: 24px;
  padding: 20px 24px;
  background: var(--bg-secondary);
  border: 1.5px solid var(--border-strong);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-shadow: 0 8px 30px -10px rgba(0, 0, 0, 0.3);
}

.cms-save-status {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
  flex: 1;
}

.cms-save-status.changed {
  color: var(--gold);
}

.cms-save-status.saved {
  color: #22c55e;
}

.cms-save-btn {
  padding: 14px 28px;
  background: var(--gold);
  color: #1a1610;
  border: 0;
  border-radius: 12px;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  white-space: nowrap;
}

.cms-save-btn:hover {
  background: var(--gold-dark);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px -5px rgba(240, 198, 116, 0.4);
}

.cms-save-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

@media (max-width: 640px) {
  .cms-image-list-item {
    grid-template-columns: 50px 1fr 36px 32px;
  }
  
  .cms-image-thumb {
    width: 50px;
    height: 50px;
  }
  
  .cms-save-bar {
    flex-direction: column;
    gap: 10px;
  }
  
  .cms-save-btn {
    width: 100%;
  }
}

/* =============================================
   أيقونات في CMS و Admin
   ============================================= */

.admin-tab svg,
.cms-nav-btn svg {
  width: 16px;
  height: 16px;
}
/* زر حفظ الصورة */
.invoice-btn-pdf {
  background: rgba(240, 198, 116, 0.15);
  color: var(--gold);
  border: 1px solid rgba(240, 198, 116, 0.3);
}

.invoice-btn-pdf:hover {
  background: rgba(240, 198, 116, 0.25);
  border-color: var(--gold);
  transform: translateY(-2px);
}

.invoice-btn-pdf:disabled {
  opacity: 0.6;
  cursor: wait;
  transform: none;
}

/* Toast للفاتورة */
.invoice-toast {
  position: fixed;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background: var(--gold);
  color: #1a1610;
  padding: 14px 28px;
  border-radius: 12px;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 700;
  box-shadow: 0 20px 60px -10px rgba(240, 198, 116, 0.5);
  opacity: 0;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 99999;
  pointer-events: none;
}

.invoice-toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}